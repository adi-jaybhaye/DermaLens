# Environment
ENVIRONMENT=development
APP_NAME="Face Skin Assessment API"

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=face_skin_assessment

# JWT Authentication
# In production, JWT_SECRET_KEY MUST be a strong, cryptographically generated random string
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Model Configuration
MODEL_PATH=training/models/efficientnet_b0_skin_concerns.pth
MODEL_VERSION=efficientnet_b0_v1
MIN_CONFIDENCE_THRESHOLD=0.35

# Optional Azure Blob Storage for Production Image Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=assessment-images
